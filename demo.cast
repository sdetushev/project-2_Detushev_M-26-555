[0.042, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.001, "o", "Введите команду: "]
[6.155, "o", "create_table users name:str age:int is_active:bool"]
[0.332, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.001, "o", "Введите команду: "]
[3.677, "o", "list_tables"]
[0.366, "o", "\r\n"]
[0.001, "o", "- users\r\n"]
[0.001, "o", "Введите команду: "]
[3.347, "o", "create_table users name:str"]
[0.316, "o", "\r\n"]
[0.001, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[0.001, "o", "Введите команду: "]
[5.115, "o", "drop_table users"]
[0.964, "o", "\r\n"]
[0.000, "o", "Таблица \"users\" успешно удалена.\r\n"]
[0.002, "o", "Введите команду: "]
[6.745, "o", "list_tables"]
[0.322, "o", "\r\n"]
[0.001, "o", "Таблиц пока нет.\r\n"]
[0.000, "o", "Введите команду: "]
[2.822, "o", "exit"]
[0.291, "o", "\r\n"]
